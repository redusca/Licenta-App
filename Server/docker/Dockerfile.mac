# syntax=docker/dockerfile:1
# -- Server image (macOS / Apple Silicon) -------------------------------------
# Build context is the Server/ folder — that is all you need to deploy.
#
# Build from Server/:
#   docker build --platform linux/arm64 -t licenta-server:mac -f docker/Dockerfile.mac .
#
# Or just use docker-compose.mac.yml which handles everything.
#
# Pre-requisites:
#   Copy src/.env.example → src/.env and fill in secrets.

# ── Stage 1: Build the React SPA ─────────────────────────────────────────────
FROM --platform=linux/arm64 node:20-slim AS frontend
WORKDIR /app/Interface
COPY Interface/package.json Interface/package-lock.json* ./
# BuildKit cache: node_modules are NOT re-downloaded if package-lock.json is unchanged.
RUN --mount=type=cache,target=/root/.npm \
    npm ci
COPY Interface/ ./
RUN npm run build

# ── Stage 2: Python server ────────────────────────────────────────────────────
FROM --platform=linux/arm64 python:3.12-slim

# BuildKit cache: apt packages are persisted between builds — no re-download on source changes.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libsndfile1 \
    ffmpeg

WORKDIR /app

# Python dependencies — two layers so the torch cache layer survives source-only rebuilds.
# BuildKit cache: pip wheels are reused across builds; torch layer is only re-run when
# requirements.txt changes (not on every source file change).
COPY src/requirements.txt ./requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    grep -v -E '^\s*(torch|torchvision)\b' requirements.txt \
    | grep -v '^\s*$' > requirements-base.txt && \
    pip install -r requirements-base.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install \
      --index-url https://download.pytorch.org/whl/cpu \
      torch torchvision

# Application source
COPY src/        ./src/
COPY Database/   ./Database/
COPY migrations/ ./migrations/
COPY alembic.ini ./alembic.ini

# React SPA built in stage 1
COPY --from=frontend /app/Interface/dist/ ./Interface/dist/

ENV PYTHONPATH=/app/src:/app

EXPOSE 8000

CMD ["sh", "-c", "cd /app && python -m alembic upgrade head && uvicorn src.main:app --host 0.0.0.0 --port 8000"]
