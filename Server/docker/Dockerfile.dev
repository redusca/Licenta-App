# syntax=docker/dockerfile:1
# Licenta Server — Development Dockerfile
#
# Used by docker-compose.dev.yml (local/personal-computer builds).
# Differences from the production Dockerfile:
#   - No Interface/dist copy (serve the React dev server separately, or skip)
#   - No release-binary copy
#   - uvicorn runs with --reload for fast iteration
#
# Build (from repo root):
#   docker build -f Server/docker/Dockerfile.dev -t licenta-server:dev .

FROM python:3.12-slim

# BuildKit cache: apt packages are persisted between builds — no re-download on source changes.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libsndfile1 \
    ffmpeg

WORKDIR /app

# Install Python dependencies — two layers so Docker cache survives a torch re-run.
# torch/torchvision use the CPU-only wheel index (no CUDA packages → ~250 MB vs 1.5 GB).
# BuildKit cache: pip wheels are reused across builds; torch layer is only re-run when
# requirements.txt changes (not on every source file change).
COPY Server/src/requirements.txt ./requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    grep -v -E '^\s*(torch|torchvision)\b' requirements.txt \
    | grep -v '^\s*$' > requirements-base.txt && \
    pip install --timeout 300 --retries 5 -r requirements-base.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --timeout 300 --retries 5 \
      --index-url https://download.pytorch.org/whl/cpu \
      torch torchvision

# Copy application source
COPY Server/src/       ./src/
COPY Server/Database/  ./Database/
COPY Server/migrations/ ./migrations/
COPY Server/alembic.ini ./alembic.ini

ENV PYTHONPATH=/app/src:/app

EXPOSE 8000

# Run Alembic migrations then start with hot-reload
CMD ["sh", "-c", "cd /app && python -m alembic upgrade head && uvicorn src.main:app --host 0.0.0.0 --port 8000 --reload --reload-dir /app/src"]
