# syntax=docker/dockerfile:1
# -- Combined Server image -----------------------------------------------------
# Runs the Licenta server in a single container (no Redis).
# Postgres still needs to be provided externally (DATABASE_URL env var).
#
# Build from the repo root:
#   docker build -t licenta-combined:latest -f Server/docker/Dockerfile.combined .
#
# Pre-requisites:
#   1. Pre-build the React SPA: cd Server/Interface && npm install && npm run build
#   2. Set DATABASE_URL, GOOGLE_API_KEY, JWT_SECRET, etc. via env / .env
#
# Run:
#   docker run -p 8000:8000 --env-file Server/src/.env licenta-combined:latest

FROM python:3.12-slim

# BuildKit cache: apt packages are persisted between builds — no re-download on source changes.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libsndfile1 \
    ffmpeg

WORKDIR /app

# Python dependencies — two layers so the torch cache layer survives source-only rebuilds.
# BuildKit cache: pip wheels are reused across builds; torch layer is only re-run when
# requirements.txt changes (not on every source file change).
COPY Server/src/requirements.txt ./requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    grep -v -E '^\s*(torch|torchvision)\b' requirements.txt \
    | grep -v '^\s*$' > requirements-base.txt && \
    pip install --timeout 300 --retries 5 -r requirements-base.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --timeout 300 --retries 5 \
      --index-url https://download.pytorch.org/whl/cpu \
      torch torchvision

# Application source
COPY Server/src/ ./src/
COPY Server/Database/ ./Database/
COPY Server/migrations/ ./migrations/
COPY Server/alembic.ini ./alembic.ini

# Built React interface (must be pre-built)
COPY Server/Interface/dist/ ./Interface/dist/

# Container source
RUN mkdir -p ./Container/docker ./Container/src
COPY Container/docker/Dockerfile         ./Container/docker/Dockerfile
COPY Container/docker/Dockerfile.runtime ./Container/Dockerfile.runtime
COPY Container/docker/run.sh     ./Container/docker/run.sh
COPY Container/docker/run.bat    ./Container/docker/run.bat
COPY Container/docker/README.md  ./Container/docker/README.md
COPY Container/src/              ./Container/src/

# Release binaries
RUN mkdir -p ./downloads
COPY APP/release/*.exe ./downloads_tmp/
RUN for f in ./downloads_tmp/*.exe; do \
      dest="./downloads/$(basename "$f" | sed 's/ /-/g')"; \
      cp "$f" "$dest"; \
    done && rm -rf ./downloads_tmp

ENV PYTHONPATH=/app/src:/app

EXPOSE 8000

CMD ["sh", "-c", "cd /app && python -m alembic upgrade head && uvicorn src.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
